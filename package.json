{
  "name": "decklink-monorepo",
  "version": "1.0.0",
  "description": "DeckLink Platform - Monorepo",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "apps/backend",
    "libs/*"
  ],
  "scripts": {
    "generate:models": "./libs/scripts/generate-models.sh",
    "install:protoc": "./libs/scripts/install-protoc.sh",
    "proto:all": "npm run install:protoc && npm run generate:models",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "start:backend": "npm run start --workspace=apps/backend",
    "build:backend": "npm run build --workspace=apps/backend",
    "test:backend": "npm run test --workspace=apps/backend",
    "lint:backend": "npm run lint --workspace=apps/backend",
    "install:all": "npm install && cd apps/frontend && flutter pub get",
    "validate:schema": "./infra/scripts/validate-proto.sh",
    "docker:build": "docker-compose -f infra/docker/docker-compose.yml build",
    "docker:up": "docker-compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker/docker-compose.yml down",
    

    "init:backend": "cd apps/backend && npx @nestjs/cli new . --package-manager=npm --skip-git",
    
    "install:workspaces": "npm install --workspace=apps/backend --workspace=libs/dto --workspace=libs/utils"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.0.0"
}